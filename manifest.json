{
  "manifest_version": 3,
  "name": "Flipnote Hatena Redirector",
  "version": "1.1",
  "description": "Redirect old Flipnote Hatena URLs to Flipnote Archive",
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "http://flipnote.hatena.com/*",
    "http://ugomemo.hatena.ne.jp/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "32": "frog.png"
  },
  "action": {
    "default_icon": "frog.png",
    "default_title": "Flipnote Hatena Redirector"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "redirect_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "flipnote-hatena-redirector@example.com",
      "strict_min_version": "109.0"
    }
  }
}
